# ==============================================================================
# FastAPI / Python Production .dockerignore
# ==============================================================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments (Crucial: prevents copying massive local dependencies)
.venv/
venv/
env/
ENV/

# Environment secrets (Prevent baking private API keys/passwords into the image)
.env
.env.*
!.env.example
*.local

# IDEs and Text Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
tests/

# Version Control
.git/
.gitignore
.github/
.gitlab-ci.yml

# Docker-specific files (Optional: prevents docker tools from copying themselves)
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation and Metadata
README.md
docs/
*.md

**/*.docx
**/*.pdf
**/*.tmp

# Database
*.db
*.sqlite
*.sqlite3